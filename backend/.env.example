# Backend environment variables
# Copy to .env for local development (non-Docker)
# For Docker, use root .env with docker-compose.yml

# Database (local dev — non-Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/un1_ecommerce?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT — change this to a strong random secret (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_me_please

# Cloudinary (image uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
